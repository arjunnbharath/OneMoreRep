# Database (Neon)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
JWT_SECRET=change-me-in-production
PORT=3001

# Admin panel credentials (separate from app user accounts)
ADMIN_USERNAME=your-admin-id
ADMIN_PASSWORD=your-secure-password
# Optional: also allow signing in with this email on /login
# ADMIN_EMAIL=admin@example.com

# Required for mobile/desktop app builds (your deployed Vercel URL, no trailing slash)
# VITE_API_URL=https://your-app.vercel.app

# Android emulator + local API (debug builds only):
# VITE_API_URL=http://10.0.2.2:3001

# Where the installed Android app checks for updates (/downloads/version.json).
# Defaults to VITE_API_URL; only set this if the site and API live on different hosts.
# VITE_APP_UPDATE_URL=https://your-app.vercel.app

# Where "Install app" downloads the Android APK from.
# Defaults to the copy shipped with the site at public/downloads/OneMoreRep.apk
# VITE_ANDROID_APK_URL=https://github.com/you/OneMoreRep/releases/latest/download/OneMoreRep.apk

# Web push (generate with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
